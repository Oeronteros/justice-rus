{
  "name": "justice-ru",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:vinext": "npm --prefix apps/portal-vinext run dev",
    "dev:cutover:pilot": "node scripts/dev-cutover.mjs pilot",
    "dev:cutover:wave2": "node scripts/dev-cutover.mjs wave2",
    "dev:cutover:all": "node scripts/dev-cutover.mjs all",
    "cutover:env:off": "node scripts/cutover-env.mjs off",
    "cutover:env:pilot": "node scripts/cutover-env.mjs pilot",
    "cutover:env:wave2": "node scripts/cutover-env.mjs wave2",
    "cutover:env:all": "node scripts/cutover-env.mjs all",
    "cutover:verify": "node scripts/verify-cutover-config.mjs",
    "build": "node scripts/prepare-build.mjs && next build",
    "build:vinext": "npm --prefix apps/portal-vinext run build",
    "start": "next start",
    "start:vinext": "npm --prefix apps/portal-vinext run start",
    "guardrails": "node scripts/check-a-level-guardrails.mjs",
    "validate": "npm run guardrails && npm run lint && npm run test && npm run test:e2e && npm run build && npm run type-check",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:vinext": "playwright test -c playwright.vinext.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "perf:smoke": "node scripts/prepare-build.mjs && next build",
    "react:doctor": "react-doctor .",
    "codegen": "npx @hey-api/openapi-ts -i ./docs/openapi.json -o ./lib/api/generated -c @hey-api/client-fetch -p @hey-api/sdk"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@milkdown/crepe": "^7.19.0",
    "@milkdown/kit": "^7.19.0",
    "@milkdown/react": "^7.19.0",
    "@tanstack/react-query": "^5.90.16",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.0",
    "next": "^16.1.6",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.70.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.94.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "axe-core": "^4.11.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "fast-check": "^4.5.3",
    "jsdom": "^27.4.0",
    "react-doctor": "^0.0.30",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.16"
  }
}
