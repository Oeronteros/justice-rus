  "components": {
    "schemas": {
      "Registration": {
        "type": "object",
        "properties": {
          "discord": {
            "type": "string",
            "description": "Discord ID пользователя"
          },
          "discordHandle": {
            "type": "string",
            "nullable": true,
            "description": "Discord username"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true,
            "description": "URL аватара"
          },
          "nickname": {
            "type": "string",
            "description": "Игровой никнейм"
          },
