{
  "openapi": "3.0.3",
  "info": {
    "title": "Silent Moonfall Guild Portal API",
    "description": "API для веб-портала гильдии Justice Mobile. Next.js frontend взаимодействует с Discord ботом через этот API.",
    "version": "2.0.0",
    "contact": {
      "name": "Silent Moonfall Guild"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Локальный Discord бот"
    },
    {
      "url": "{DISCORD_BOT_API_URL}",
      "description": "Продакшен Discord бот",
      "variables": {
        "DISCORD_BOT_API_URL": {
          "default": "https://your-bot.example.com"
        }
      }
    }
  ],
  "paths": {
    "/api/registrations": {
      "get": {
        "summary": "Получить список регистраций",
        "description": "Возвращает список всех участников гильдии с их статистиками",
        "tags": [
          "Registrations"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Registration"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/registration": {
      "patch": {
        "summary": "Обновить статистику регистрации",
        "description": "Обновляет KPI, ELO и другие статистики участника",
        "tags": [
          "Registrations"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRegistrationStats"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Статистика обновлена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateRegistrationStatsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/schedule": {
      "get": {
        "summary": "Получить расписание",
        "description": "Возвращает список событий гильдии",
        "tags": [
          "Schedule"
        ],
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "description": "Язык локализации расписания",
            "schema": {
              "type": "string",
              "enum": [
                "ru",
                "en",
                "zh"
              ],
              "default": "ru"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
